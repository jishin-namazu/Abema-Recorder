# ── DASH 引擎（.mpd 地址，Widevine 加密）──────────────────────────────

# DASH 清单地址。复制方法：Edge 打开播放页 → F12 → Network → 过滤器输入 mpd
# → 找到 index.mpd 请求 → 右键 Copy → Copy link address。
mpd=

# license 令牌。三种写法任选：
#   1. 完整 license URL：Network 过滤器输入 widevine，找到对
#      license.p-c3-e.abema-tv.com/playout/widevine?t=...&pt=... 的 POST 请求，复制完整 URL；
#   2. 查询串 t=...&pt=...；
#   3. pt= 后面的 JWT 本体。
# pt JWT 有效期约 26 小时，过期后重新复制。
token=

# 或者分开写完整 license 地址（等价于 token= 的第 1 种写法）：
# license=

# license 请求需要额外请求头时，每行一个 Name: value 存成文件后启用：
# headers=headers.txt

# 已有 KID:KEY 时跳过 license 步骤（也不需要 device.wvd）：
# key=

# 指定清晰度（2160p/1080p/720p/480p/360p）；不写则录制最高码率：
# quality=1080p

# 直播（动态 MPD）的本地滚动 m3u8 服务，默认 127.0.0.1:8080，无需填写；
# 改地址或端口时（可只写端口）：
# hls=127.0.0.1:8080

# ── HLS 引擎（频道页 / now-on-air / 裸 m3u8，AES-128）─────────────────

# ABEMA 频道页或直播页地址（经 Streamlink 解析），或裸媒体 m3u8 地址：
# url=https://abema.tv/now-on-air/abema-special

# Streamlink 清晰度，默认 1080p：
# quality=1080p

# 本地播放列表服务地址，默认 127.0.0.1:8080：
# hls=127.0.0.1:8080
